# KAN Logistics — Apache (Hostinger) rules for the static build.

ErrorDocument 404 /404.html

# Media types older Apache builds may not know
AddType image/webp .webp
AddType video/mp4 .mp4
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /services.html -> /services (keep the established extensionless URLs canonical)
  RewriteCond %{THE_REQUEST} \s/+([^.?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /services -> services.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Build output in /assets is content-hashed and never changes under the same name.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
